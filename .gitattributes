# Store and check out text as LF regardless of any machine's core.autocrlf.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.npz binary
*.npy binary
*.pt binary
*.pth binary
*.pkl binary
*.zip binary
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
