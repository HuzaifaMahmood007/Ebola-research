{"nodes": [{"id": "progress_outcomes_results_summary_week3_summary", "label": "Phase 3 Week 3 Results Summary", "file_type": "document", "source_file": "progress/outcomes/results_summary.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-disease and joint multi-disease results over four development datasets, four horizons and five seeds, in count space, with Ebola untouched."}, {"id": "progress_outcomes_results_summary_joint_negative_transfer", "label": "Joint Training Helps Nothing and Hurts the Smallest Datasets", "file_type": "rationale", "source_file": "progress/outcomes/results_summary.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dengue is flat by construction because it is 98.5% of the nodes, so it is not a test; the small panels that are the real test got worse, and they are the Ebola-scale ones. Two explanations were undistinguished by that run: genuine negative transfer, or a weighting artifact from over-cycling tiny data."}, {"id": "progress_outcomes_results_summary_japan_loses_to_seasonal", "label": "Japan Influenza Loses to Seasonal-Naive Everywhere", "file_type": "concept", "source_file": "progress/outcomes/results_summary.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural rather than a bug: the 20-week lookback cannot reach last year's amplitude, though the encoder does use seasonal phase."}, {"id": "progress_outcomes_results_summary_us_states_clean_win", "label": "US-States Influenza Is a Clean Win at Every Horizon and Metric", "file_type": "concept", "source_file": "progress/outcomes/results_summary.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "progress_outcomes_results_summary_lodo_probe_corrected", "label": "LODO Transfer Probe, Corrected 202