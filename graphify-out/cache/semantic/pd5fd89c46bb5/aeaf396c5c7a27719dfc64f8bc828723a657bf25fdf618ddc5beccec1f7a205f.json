{"nodes": [{"id": "progress_decisions_ebola_prereg_ebola_prereg", "label": "Ebola Support-Set Pre-Registration", "file_type": "document", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen 2026-08-07 before any Ebola score; nothing may be revised after the first score so the outcome is reported against what was written, making score-Ebola-once a stated methodological contribution."}, {"id": "progress_decisions_ebola_prereg_primary_arm_l12", "label": "L12 Primary Ebola Support Arm", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "12-week cutoff 2014-06-28, 59 support cells over 18 districts; carries the headline because it is the operational emerging-outbreak regime. Has zero adaptation pairs at h15."}, {"id": "progress_decisions_ebola_prereg_secondary_arm_l20", "label": "L20 Secondary Ebola Support Arm", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20-week cutoff 2014-08-23, 113 cells over 36 districts, labelled secondary in every table; worth its compute because if it does not beat L12 at h10/h15 the failure is not support-limited."}, {"id": "progress_decisions_ebola_prereg_dropped_arm_l19", "label": "L19 Dropped Support Arm", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded in the manifest as considered-and-rejected so the arm set cannot later be read as the only thing examined."}, {"id": "progress_decisions_ebola_prereg_freeze_ebola_arms", "label": "freeze_ebola_arms.py", "file_type": "code", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds both arms from the raw OCHA xlsx in one pass and asserts every published count before writing; content digest taken over arrays not file bytes because a .npz zip carries wall-clock timestamps."}, {"id": "progress_decisions_ebola_prereg_scored_vs_reachable", "label": "Scored vs Reachable Query Counts", "file_type": "rationale", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scored (757/766/765/642) uses one common origin set t in [19,36] for every horizon, which is what bundles.origins() returns and score_predictions scores; reachable (1151/1075/866/642) counts per-horizon origins and overstates h3-h10 by 34-52 per cent. Horizons are comparable only if read at the same origins."}, {"id": "progress_decisions_ebola_prereg_adapter_stopping_rule", "label": "Leave-One-District-Out Adapter Stopping Rule (A2)", "file_type": "rationale", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ebola has no validation split by construction, so epoch count would otherwise be a free parameter chosen after seeing the answer; LODO CV inside the support set reads no query cell."}, {"id": "progress_decisions_ebola_prereg_short_window_left_pad", "label": "Zero Left-Pad for Short Windows (A3)", "file_type": "rationale", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "window_slice refused t<19 so no adaptation origin could be built; zero equals the per-node mean in normalised space, but sin_doy/cos_doy are zeroed too, which is not a point on the unit circle, so a padded step carries an impossible calendar date."}, {"id": "progress_decisions_ebola_prereg_trunk_all_dev_joint", "label": "All-Dev-Bundle Joint Trunk", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared encoder on all five dev bundles with adapter_groups=[0,1,1,1,2] so each disease gets one adaptation surface; 5 seeds, 91,000 steps, trunk_patience=30 against LDO3's 12 because the cosine schedule is scaled to a budget early stopping never reaches."}, {"id": "progress_decisions_ebola_prereg_zero_shot_mean_adapter", "label": "Zero-Shot Mean-Adapter Definition", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Element-wise mean of the three trained in-disease adapters applied to Ebola with no fitting; no Ebola label touched at any point."}, {"id": "progress_decisions_ebola_prereg_few_shot_adapter", "label": "Few-Shot FiLM Adapter (1,428 params)", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen trunk plus one fresh FiLM-plus-quantile-head adapter fit on that arm's support cells only."}, {"id": "progress_decisions_ebola_prereg_reference_floors", "label": "Persistence and Support-Mean Floors", "file_type": "rationale", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seasonal-naive is dropped rather than reported as a third floor: Ebola has T=52 so the t-52 lag is out of panel at every scored origin and it would collapse to a duplicate of persistence."}, {"id": "progress_decisions_ebola_prereg_expectation_e1", "label": "E1: Zero-Shot Loses to Persistence at Every Horizon", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High confidence, because LDO3 found transfer negative in 25 of 36 cells and Ebola is a further shift than any development fold."}, {"id": "progress_decisions_ebola_prereg_expectation_e2", "label": "E2: Few-Shot Beats Zero-Shot at h3 and h5", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moderate confidence; the weakest thing the adapter has to do and where it has the most examples."}, {"id": "progress_decisions_ebola_prereg_expectation_e3", "label": "E3: Few-Shot Still Loses to Persistence on the Primary Arm", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moderate confidence; if wrong it is the best outcome available and will be said plainly."}, {"id": "progress_decisions_ebola_prereg_expectation_e4", "label": "E4: h15 Head Block Must Be a Uniform Shrink of Its Initialisation", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a prediction but a consequence of zero h15 adaptation pairs: the mask zeroes the h15 pinball term so Adam's update is exactly zero and only AdamW's decoupled weight decay moves the block. Any departure from proportionality means a label-driven gradient reached a horizon with no labels, a bug not a result."}, {"id": "progress_decisions_ebola_prereg_expectation_e5", "label": "E5: Secondary Arm Beats Primary at h10 and h15", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single most informative cell: if the secondary arm does not win, the failure is not support-limited and no extra Ebola labelling rescues the few-shot framing."}, {"id": "progress_decisions_ebola_prereg_expectation_e6", "label": "E6: Reporting Standard for the Ebola Run", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mean and sd over the 5 frozen seeds plus a bootstrap CI over districts and origins; within-noise cells get no direction; no averaging across diseases; primary-arm h10/h15 labelled zero-shot, never few-shot."}, {"id": "progress_decisions_ebola_prereg_amendment_log", "label": "Pre-Registration Amendment Log", "file_type": "document", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every change with its reason, all predating the first Ebola score; nothing may be added once scoring has run."}, {"id": "progress_decisions_ebola_prereg_amendment_a7", "label": "Amendment A7: Both Arms Archive Count-Space Quantiles", "file_type": "rationale", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The zero-shot arm wrote no quantiles, exactly the omission that cost the development-fold zero-shot arm its whole UQ block; under score-once a quantile array not written now can never be written, so WIS, CRPS, coverage and PIT would be permanently unavailable."}, {"id": "progress_decisions_ebola_prereg_uncertainty_calibration", "label": "Post-Hoc Conformal Calibration Registration", "file_type": "rationale", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "G4 requires calibrated uncertainty but the variant is unsettled, so the mechanism is registered and the variant left open under four binding constraints: post hoc only, reported alongside never instead, never selected on Ebola, truth consumption declared."}, {"id": "progress_decisions_ebola_prereg_c8_guard", "label": "C8 Ebola-Prefix Leakage Guard", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guards in train/loop.py, train/lodo.py, train/joint.py and bundles.py now match on the ebola name prefix rather than the exact string, so ebola_L12 and ebola_L20 cannot slip past them."}, {"id": "progress_decisions_ebola_prereg_support_scaler", "label": "Support-Only log1p Plus Z-Score Scaler", "file_type": "concept", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pooled scaler fit on support cells alone so each arm has its own; both arms remain mis-calibrated against the ~19-case mean scored cell, which is what the FiLM adapter is meant to correct."}, {"id": "progress_decisions_ebola_prereg_scoring_protocol", "label": "Score-Each-Arm-Once Protocol", "file_type": "rationale", "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each arm scored exactly once against the frozen hashed file; a repeat for a defect must be recorded with its reason before the re-scored numbers are used."}], "edges": [{"source": "progress_decisions_ebola_prereg_ebola_prereg", "target": "progress_decisions_ebola_prereg_primary_arm_l12", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_ebola_prereg", "target": "progress_decisions_ebola_prereg_secondary_arm_l20", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_ebola_prereg", "target": "progress_decisions_ebola_prereg_dropped_arm_l19", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_freeze_ebola_arms", "target": "progress_decisions_ebola_prereg_primary_arm_l12", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_freeze_ebola_arms", "target": "progress_decisions_ebola_prereg_secondary_arm_l20", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_primary_arm_l12", "target": "progress_decisions_ebola_prereg_support_scaler", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_secondary_arm_l20", "target": "progress_decisions_ebola_prereg_support_scaler", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_scored_vs_reachable", "target": "progress