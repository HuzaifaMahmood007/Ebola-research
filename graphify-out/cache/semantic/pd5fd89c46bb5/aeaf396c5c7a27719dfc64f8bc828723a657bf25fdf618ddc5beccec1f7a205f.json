aci", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_scoring_protocol", "target": "progress_decisions_ebola_prereg_c8_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_c8_guard", "target": "progress_decisions_ebola_prereg_primary_arm_l12", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_expectation_e1", "target": "progress_outcomes_ldo3_results_negative_transfer_finding", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_amendment_a7", "target": "progress_outcomes_ldo3_results_zero_shot_no_quantiles_gap", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_ebola_prereg", "target": "progress_decisions_client_decisions_a3_calendar_prefix_support", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_ebola_prereg", "target": "progress_decisions_review_doc_preregistration_score_once", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_trunk_all_dev_joint", "target": "progress_decisions_review_doc_covid_third_disease", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_expectation_e6", "target": "progress_decisions_review_doc_reporting_standards", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}, {"source": "progress_decisions_ebola_prereg_uncertainty_calibration", "target": "progress_decisions_review_doc_conformal_split_reservation", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "progress/decisions/Ebola_Prereg.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ebola_prereg_freeze_packet", "label": "Ebola Support-Set Freeze Packet", "nodes": ["progress_decisions_ebola_prereg_ebola_prereg", "progress_decisions_ebola_prereg_primary_arm_l12", "progress_decisions_ebola_prereg_secondary_arm_l20", "progress_decisions_ebola_prereg_freeze_ebola_arms", "progress_decisions_decisions_d16_ebola_support_length", "progress_decisions_review_doc_preregistration_score_once"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/decisions/Ebola_Prereg.md"}]}