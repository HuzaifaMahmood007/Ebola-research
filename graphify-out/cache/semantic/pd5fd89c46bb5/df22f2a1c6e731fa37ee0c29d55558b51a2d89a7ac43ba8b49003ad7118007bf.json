{"nodes": [{"id": "progress_outcomes_results_matrix_results_matrix", "label": "Encoder Results Matrix: Single vs Joint vs LODO vs LDO", "file_type": "document", "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated by results_matrix.py from the JSON records on disk, with every cell recomputed rather than carried over from an earlier write-up."}, {"id": "progress_outcomes_results_matrix_coverage_table", "label": "Coverage Table: What Actually Exists on Disk", "file_type": "rationale", "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seed counts per regime and dataset are printed first because a 1-seed cell cannot carry a dispersion figure, so the client's standard is unmet there by data rather than by choice."}, {"id": "progress_outcomes_results_matrix_reference_question", "label": "The Reference Question: 1-Seed vs 5-Seed Reference", "file_type": "rationale", "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds the transfer number fixed and varies only the reference so the size of that effect is visible rather than argued; a large gap means the headline was reporting the reference, not the transfer."}, {"id": "progress_outcomes_results_matrix_lodo_vs_ldo", "label": "LODO versus LDO Side by Side", "file_type": "rationale", "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leave-one-dataset-out is population transfer with the disease still in training; leave-one-disease-out is the cross-disease number the central claim rests on. The client stated in advance that the honest number would come in weaker."}, {"id": "progress_outcomes_results_matrix_like_for_like_node_check", "label": "Like-for-Like Node-Population Check", "file_type": "rationale", "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "score.py drops constant-truth nodes and a different prediction can change which nodes qualify, so equal node counts are checked per dataset, horizon and seed rather than assumed."}, {"id": "progress_outcomes_results_matrix_pcc_delta_points", "label": "PCC Deltas Reported in Correlation Points", "file_type": "rationale", "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A correlation is signed and can sit near zero, where a percent change explodes or flips sign on a model that genuinely improved."}, {"id": "progress_outcomes_results_matrix_lodo_zero_shot_missing_nrmse", "label": "LODO Zero-Shot Has No nrmse", "file_type": "concept", "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-shot runs write JSON only and discard the per-node arrays, so the rescore path that globs per-node npz files structurally cannot backfill them; recovery needs a rerun, not a rescore."}], "edges": [{"source": "progress_outcomes_results_matrix_results_matrix", "target": "progress_outcomes_results_matrix_coverage_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/outcomes/Results_Matrix.md", "source_location": null, "weight": 1.0}, {"source": "progress_outcomes_results_matrix_results_matrix", "target": "progress_outcomes_results_matrix_reference_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/outco