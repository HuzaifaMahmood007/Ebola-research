{"nodes": [{"id": "progress_planning_final_internal_project_brief_framework", "label": "Generalizable Spatio-Temporal Framework for EID Forecasting", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disease-agnostic by construction because recent SOTA is single-disease or stays inside one disease family and several papers explicitly flag cross-disease transferability as open future work; the unoccupied gap is the intersection (disease-agnostic x transferable x few-shot x calibrated)."}, {"id": "progress_planning_final_internal_project_brief_g1_disease_agnostic_encoder", "label": "G1 - Disease-agnostic spatio-temporal architecture", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operating on a standardised input schema is what makes the architecture disease-agnostic; the input, not the model, carries the guarantee."}, {"id": "progress_planning_final_internal_project_brief_g2_transferable_representations", "label": "G2 - Transferable representations across data-rich diseases", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidenced by leave-one-disease-out; a single development disease would make the general-framework claim non-credible."}, {"id": "progress_planning_final_internal_project_brief_g3_few_shot_ebola_generalisation", "label": "G3 - Few-shot generalisation to data-scarce Ebola", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ebola is treated as a few-shot test precisely because the data is thin; scarcity is the design premise rather than an obstacle."}, {"id": "progress_planning_final_internal_project_brief_g4_calibrated_uncertainty", "label": "G4 - Calibrated uncertainty on all forecasts", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "progress_planning_final_internal_project_brief_g5_explainability", "label": "G5 - Explainability of forecasts", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "progress_planning_final_internal_project_brief_g6_sota_benchmark", "label": "G6 - Competitive performance vs SOTA re-run under identical conditions", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-running baselines on identical data, splits, preprocessing, metrics and horizon is the only basis on which a SOTA claim survives review."}, {"id": "progress_planning_final_internal_project_brief_g7_reproducible_contribution", "label": "G7 - Reproducible submission-ready contribution", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "progress_planning_final_internal_project_brief_four_design_pillars", "label": "Four design pillars (none disease-specific)", "file_type": "rationale", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encoder, epi-informed inductive bias, transferable representation learning with few-shot adaptation, and calibrated uncertainty; each is chosen so that nothing in the methodology is specialised to one disease."}, {"id": "progress_planning_final_internal_project_brief_epidemiology_informed_inductive_bias", "label": "Epidemiology-informed inductive bias (metapopulation / physics-informed loss)", "file_type": "rationale", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tagged SUGGESTION not REQUIRED: it buys data efficiency and generalisation but mechanistic hybridisation is not one of the four axes of the identified research gap, so it dilutes a contribution that is already precisely located."}, {"id": "progress_planning_final_internal_project_brief_conformal_prediction_recommendation", "label": "Conformal prediction as the recommended UQ route", "file_type": "rationale", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a74, \u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model-agnostic and post-hoc, so UQ stays out of the Week-3 model build; a Bayesian alternative would move UQ into the model build and must therefore be decided before Week 3."}, {"id": "progress_planning_final_internal_project_brief_six_week_milestone_plan", "label": "Six-week milestone plan (30 working days)", "file_type": "document", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a77, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Milestones run in dependency order; two activities span phases by design - baseline reproduction starts W1 and is re-run on harmonised data in W3, and manuscript drafting starts in parallel from W4 so W6 is assembly rather than writing from scratch."}, {"id": "progress_planning_final_internal_project_brief_out_of_scope_risk_stratification", "label": "Out of scope: risk stratification and intervention ranking", "file_type": "rationale", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No agreed ground-truth labels exist, so neither can be trained or validated rigorously; including them would weaken the paper. Kept as a natural future extension."}, {"id": "progress_planning_final_internal_project_brief_ebola_data_scarcity_risk", "label": "Risk: Ebola data scarcity", "file_type": "concept", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mitigated by confirming usable signal in the Week-2 audit before the few-shot design is allowed to rest on it."}, {"id": "progress_planning_final_internal_project_brief_identical_conditions_baseline_rerun", "label": "Baselines re-run under identical conditions", "file_type": "rationale", "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer official code; where none exists, validate a from-scratch reimplementation against the paper's reported numbers before comparing."}], "edges": [{"source": "progress_planning_final_internal_project_brief_four_design_pillars", "target": "progress_planning_final_internal_project_brief_framework", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "progress/planning/Final Internal Project Brief.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "progress_planning_final_internal_project_brief_four_design_pillars", "target": "p